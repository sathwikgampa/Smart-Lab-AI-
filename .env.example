# Copy to your shell environment (the app reads real environment variables).
ANTHROPIC_API_KEY=
SMARTLAB_LLM_MODEL=claude-opus-5-5
SMARTLAB_LLM_EFFORT=medium
SMARTLAB_EMBEDDINGS=auto
SMARTLAB_VECTOR_STORE=auto
SMARTLAB_MAX_UPLOAD_MB=25
SMARTLAB_LITERATURE_ONLINE=true
SMARTLAB_SECRET_KEY=change-me
SMARTLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Leave unset to use the local SQLite file (backend/instance/smartlab.db).
# Set to a PostgreSQL URL to use Supabase instead. In the Supabase dashboard go to
# Connect and copy the "Session pooler" URI (IPv4). Use the "Transaction pooler"
# (port 6543) for serverless hosts. URL-encode special characters in the password.
# Put the real value in .env or your host's secret settings, never in this file.
# SMARTLAB_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL is also honoured as a fallback when it is a postgres(ql):// URL.
# SMARTLAB_DB_POOL_MAX=5
